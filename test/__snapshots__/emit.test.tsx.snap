// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`cli renders help text for a command or a namespace, path from the app 1`] = `
"task run <prompt> [--engine <engine>] [--wait]

Dispatch a task to an engine

Prints the task id; add --wait to block until it finishes.

Arguments:
  <prompt>           what to do
  --engine <engine>  engine name
  --wait

Exit codes:
  0  done
  2  engine failed

Examples:
  app task run "fix the build""
`;

exports[`cli renders help text for a command or a namespace, path from the app 2`] = `
"task

Run and inspect tasks

Tasks run in the background.

Commands:
  task run <prompt> [--engine <engine>] [--wait]: Dispatch a task to an engine
  task list [--limit <limit>]: List recent tasks"
`;

